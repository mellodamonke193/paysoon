# Copy to .env for local development. In production, set these as environment
# variables / secrets on your host (never commit real values).

NODE_ENV=production
PORT=3000
# Public URL of the app (must be https:// in production). Used in emails and for CSRF origin checks.
APP_URL=https://yourdomain.com
# 32+ random characters: openssl rand -hex 32
SECRET_KEY=
# Set to 1 when running behind a single reverse proxy / load balancer (Fly, Render, Railway, Nginx).
TRUST_PROXY=1
# Where the SQLite database lives. Put it on a persistent volume.
DATABASE_PATH=/data/paysoon.db

# --- Legal identity (shown in Terms, Privacy Policy, footer and every email) ---
# The legal name of whoever runs the service: ideally your LLC, e.g. "Paysoon LLC".
COMPANY_NAME=
# A postal address (a registered agent or virtual mailbox is fine). Anti-spam laws expect one.
COMPANY_ADDRESS=
# e.g. "the State of Delaware, USA"
GOVERNING_LAW=
# Contact for customers, recipients and abuse/security reports.
SUPPORT_EMAIL=

# --- Email (https://resend.com) ---------------------------------------------
RESEND_API_KEY=
# Address on a domain you verified in Resend, e.g. reminders@mail.yourdomain.com
EMAIL_FROM=

# --- Billing (https://stripe.com) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of your recurring monthly "Pro" price, e.g. price_1Q...
STRIPE_PRICE_PRO=
PRO_PRICE_LABEL=$19
PRO_PRICE_MONTHLY=19
# Optional yearly price (shown as a second option on the billing page).
STRIPE_PRICE_PRO_YEARLY=
PRO_YEARLY_PRICE_LABEL=$190
# Optional free trial for first-time subscribers, in days (0 = no trial).
PRO_TRIAL_DAYS=0

# --- You ---------------------------------------------------------------------
# Your login email. Unlocks /admin (MRR, signups, sending health, suspended accounts) once verified.
ADMIN_EMAIL=

# --- Optional tuning -----------------------------------------------------------
# APP_NAME=Paysoon
# FREE_ACTIVE_INVOICES=3
# FREE_DAILY_EMAILS=20
# PRO_DAILY_EMAILS=400
# ABUSE_REPORTS_TO_SUSPEND=3
